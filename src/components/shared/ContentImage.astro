---
import type { ImageSource } from "@/lib/content/types";

/** Plain <img> using the original Sanity asset URL without transformations. */
interface Props {
  image: ImageSource;
  class?: string;
  priority?: boolean;
}
const { image, class: className, priority = false } = Astro.props;
---

<img
  src={image.src}
  width={image.width}
  height={image.height}
  alt={image.alt}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  class:list={["block", className]}
/>
