---
import MutedText from "./MutedText.astro";

/**
 * "Label:  value" row used everywhere on the site (Selected work:, Filter:,
 * Work:, Category: …). The label keeps its width; the value column flexes.
 */
interface Props {
  label: string;
  class?: string;
  stackOnPhone?: boolean;
}
const { label, class: className, stackOnPhone = false } = Astro.props;
---

<div class:list={["flex w-full items-start gap-1 overflow-clip", stackOnPhone && "flex-col tablet:flex-row", className]}>
  <MutedText>{label}</MutedText>
  <div class:list={["flex flex-col", stackOnPhone ? "w-full tablet:w-auto tablet:flex-[1_0_0px]" : "flex-[1_0_0px]"]}>
    <slot />
  </div>
</div>
